<?xml version="1.0" encoding="utf-8"?>
<!--
  OriTrainer — 原版（Ori and the Blind Forest, ori.exe）字段对照表
  =================================================================
  ⚠⚠ 状态：**本表尚未实机核验**（我们的逆向工作全部在终极版完成）。

  本表与修改器的功能列表保持同步（功能名、字段名一致），但：

    1. 所有「符号+偏移」字段的**偏移值都是从终极版抄来的**，原版是否相同
       **未知**。原版是另一个 build（Unity 5.0，Assembly-CSharp.dll 不同），
       mono 的字段重排结果可能不同 —— 必须重新核验。
    2. 核验方法（先启动原版并进入存档）：
           cd GoTrainer
           go run ./cmd/probe offs SeinCharacter Level Energy Mortality -vanilla
           go run ./cmd/probe offs SeinLevel SkillPoints -vanilla
           ... 逐个类核验后，把本文件的偏移改掉
       命令加 `-vanilla` 即附加到 ori.exe。
    3. 下方的「第三方原版指针链」来自网络 CE 表（明确引用 "ori.exe"），
       是**可直接使用**的参考数据，但同样未由我们独立验证。

  定位方法（与终极版相同，待核验）：游戏静态字段 Characters.Sein 与
  Characters.Current 在低地址区形成 [P,0,0,P] 相邻双引用；扫到后按对象链取值。
  详见 README「维护手册」。
-->
<CheatTable CheatEngineTableVersion="18">
  <CheatEntries>

    <CheatEntry>
      <ID>2000</ID>
      <Description>"★ 必读：原版字段偏移全部未核验（抄自终极版）；核验方法见 README 维护手册"</Description>
      <LastState/>
      <Color>FF0000</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>2001</ID>
          <Description>"核验命令: probe offs &lt;类名&gt; &lt;字段名...&gt; -vanilla （原版进程 ori.exe）"</Description>
          <LastState/>
          <Color>FF8000</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>2002</ID>
          <Description>"符号: sein=SeinCharacter  abilities=SeinAbilities  level=SeinLevel  energy=SeinEnergy  mortality=SeinMortality  health=SeinHealthController  soulflame=SeinSoulFlame  jump=SeinJump  doublejump=SeinDoubleJump  playerab=PlayerAbilities  death=SeinDeathCounter  gw=GameWorld  diffc=DifficultyController  timer=GameTimer  keys=Keys 静态数据块  dash=SeinDashAttack  mapnav=AreaMapDebugNavigation（用 probe bases -xml -vanilla 生成）"</Description>
          <LastState/>
          <Color>808080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>

