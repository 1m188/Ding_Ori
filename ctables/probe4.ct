<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="41">
  <LuaScript>
local out = io.open('D:/code/Ding_Ori/ctables/mono_result.txt', 'w')
local function log(s) out:write(tostring(s) .. '\n') out:flush() end
local function hf(x) return string.format('0x%X', tonumber(x) or 0) end

log('=== probe4 start ===')
openProcess('ori.exe')
log('pid: ' .. tostring(getOpenedProcessID()))
local dc = LaunchMonoDataCollector()
log('datacollector: ' .. tostring(dc))

local img = nil
local asms = mono_enumAssemblies()
for _, a in ipairs(asms or {}) do
  local im = mono_getImageFromAssembly(a)
  if mono_image_get_name(im) == 'Assembly-CSharp' then img = im end
end
log('image: ' .. hf(img))

local targets = { ['SaveGameController']=true, ['SaveGameData']=true, ['GameController']=true, ['SeinCharacter']=true, ['SeinEnergy']=true, ['SeinHealth']=true, ['SeinAbilities']=true, ['SeinDeathCounter']=true }
local found = {}
local classes = mono_image_enumClasses(img)
log('class count: ' .. tostring(classes and #classes or 'nil'))
for _, c in ipairs(classes or {}) do
  local okn, nm = pcall(mono_class_getName, c)
  if okn and nm and targets[tostring(nm)] and not found[tostring(nm)] then
    local okns, ns = pcall(mono_class_getNamespace, c)
    found[tostring(nm)] = { class=c, ns=okns and tostring(ns) or '?' }
    log('FOUND ' .. tostring(ns) .. '.' .. tostring(nm) .. ' class=' .. hf(c))
  end
end

for name, info in pairs(found) do
  log('=== ' .. name .. ' (ns=' .. info.ns .. ') class=' .. hf(info.class))
  local okf, fields = pcall(mono_class_enumFields, info.class)
  if okf then
    for _, f in ipairs(fields or {}) do
      log('  field ' .. tostring(f.name) .. ' offset=' .. tostring(f.offset) .. ' static=' .. tostring(f.isStatic))
    end
  else
    log('  enumFields error: ' .. tostring(fields))
  end
  local oks, saddr = pcall(mono_class_getStaticFieldAddress, 0, info.class)
  if oks and saddr then log('  staticAddr: ' .. hf(saddr)) else log('  staticAddr: nil') end
end

log('=== probe4 done ===')
out:close()
  </LuaScript>
</CheatTable>
