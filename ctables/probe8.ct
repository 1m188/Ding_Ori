<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="41">
  <LuaScript>
local out = io.open('D:/code/Ding_Ori/ctables/mono_result.txt', 'w')
local function log(s) out:write(tostring(s) .. '\n') out:flush() end
local function hf(x) return string.format('0x%X', tonumber(x) or 0) end

log('=== probe8: sein character via findInstances ===')
openProcess('ori.exe')
local dc = LaunchMonoDataCollector()

local img = nil
for _, a in ipairs(mono_enumAssemblies() or {}) do
  local im = mono_getImageFromAssembly(a)
  if mono_image_get_name(im) == 'Assembly-CSharp' then img = im end
end
local byname = {}
for _, c in ipairs(mono_image_enumClasses(img) or {}) do
  byname[tostring(c.classname or '')] = c.class
end

local dom = mono_enumDomains()[1]

-- SeinCharacter 实例
local sc = byname['SeinCharacter']
local ok1, insts1 = pcall(mono_class_findInstancesOfClassListOnly, dom, sc)
if ok1 then
  log('SeinCharacter instances: ' .. tostring(insts1 and #insts1 or 0))
  for _, p in ipairs(insts1 or {}) do
    log('  SC=' .. hf(p))
    local en = readInteger(p + 60)
    if en and en ~= 0 then
      log('    Energy.Current=' .. tostring(readFloat(en + 32)) .. ' Max=' .. tostring(readFloat(en + 36)))
    end
    local mor = readInteger(p + 64)
    if mor and mor ~= 0 then
      local h = readInteger(mor + 12)
      log('    Mortality.Health ptr=' .. hf(h or 0))
      if h and h ~= 0 then
        log('      Amount=' .. tostring(readFloat(h + 28)) .. ' MaxHealth=' .. tostring(readFloat(h + 32)))
      end
    end
  end
else
  log('findInstances SeinCharacter error: ' .. tostring(insts1))
end

-- SeinHealthController 实例直接找
local hc = byname['SeinHealthController']
local ok2, insts2 = pcall(mono_class_findInstancesOfClassListOnly, dom, hc)
if ok2 then
  log('SeinHealthController instances: ' .. tostring(insts2 and #insts2 or 0))
  for _, p in ipairs(insts2 or {}) do
    log('  HC=' .. hf(p) .. ' Amount=' .. tostring(readFloat(p + 28)) .. ' MaxHealth=' .. tostring(readFloat(p + 32)))
  end
end

-- SeinEnergy 实例直接找
local se = byname['SeinEnergy']
local ok3, insts3 = pcall(mono_class_findInstancesOfClassListOnly, dom, se)
if ok3 then
  log('SeinEnergy instances: ' .. tostring(insts3 and #insts3 or 0))
  for _, p in ipairs(insts3 or {}) do
    log('  SE=' .. hf(p) .. ' Current=' .. tostring(readFloat(p + 32)) .. ' Max=' .. tostring(readFloat(p + 36)))
  end
end

-- SeinDeathCounter / SeinLevel 再确认（本会话内）
local sdc = byname['SeinDeathCounter']
local a1 = mono_class_getStaticFieldAddress(0, sdc)
log('SeinDeathCounter staticAddr=' .. hf(a1) .. ' Instance=' .. hf(readInteger(a1) or 0) .. ' deathCounter=' .. tostring(readInteger(readInteger(a1) + 20)))

local lvl = byname['SeinLevel']
local ok4, insts4 = pcall(mono_class_findInstancesOfClassListOnly, dom, lvl)
if ok4 then
  for _, p in ipairs(insts4 or {}) do
    local sp = readInteger(p + 36)
    if sp and sp > 0 then log('SeinLevel LIVE=' .. hf(p) .. ' SkillPoints=' .. sp .. ' Exp=' .. tostring(readInteger(p + 44))) end
  end
end

log('=== probe8 done ===')
out:close()
  </LuaScript>
</CheatTable>
