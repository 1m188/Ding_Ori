<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="41">
  <LuaScript>
local out = io.open('D:/code/Ding_Ori/ctables/de_mono_result.txt', 'w')
local function log(s) out:write(tostring(s) .. '\n') out:flush() end
local function hf(x) return string.format('0x%X', tonumber(x) or 0) end

log('=== DE probe1 start ===')
openProcess('oriDE.exe')
log('pid: ' .. tostring(getOpenedProcessID()))
local dc = LaunchMonoDataCollector()
log('datacollector: ' .. tostring(dc))

local img = nil
local asms = mono_enumAssemblies()
log('assembly count: ' .. tostring(asms and #asms or 'nil'))
for _, a in ipairs(asms or {}) do
  local im = mono_getImageFromAssembly(a)
  local nm = mono_image_get_name(im)
  if nm == 'Assembly-CSharp' then img = im end
end
if not img then
  log('Assembly-CSharp NOT FOUND')
  log('=== DE probe1 done ===')
  out:close()
  return
end
log('image: ' .. hf(img))

local targets = { ['SaveGameController']=true, ['SaveGameData']=true, ['GameController']=true, ['SeinCharacter']=true, ['SeinEnergy']=true, ['SeinHealthController']=true, ['SeinMortality']=true, ['SeinAbilities']=true, ['SeinDeathCounter']=true, ['SeinLevel']=true }
local found = {}
local classes = mono_image_enumClasses(img)
log('class count: ' .. tostring(classes and #classes or 'nil'))
for _, c in ipairs(classes or {}) do
  local cn = tostring(c.classname or '')
  if targets[cn] and not found[cn] then
    found[cn] = { class=c.class, ns=tostring(c.namespace or '') }
    log('FOUND ' .. cn .. ' class=' .. hf(c.class))
  end
end

for name, info in pairs(found) do
  log('=== ' .. name .. ' ns=' .. info.ns .. ' class=' .. hf(info.class))
  local okf, fields = pcall(mono_class_enumFields, info.class)
  if okf then
    for _, f in ipairs(fields or {}) do
      log('  field ' .. tostring(f.name) .. ' offset=' .. tostring(f.offset) .. ' static=' .. tostring(f.isStatic))
    end
  else
    log('  enumFields error: ' .. tostring(fields))
  end
  local oks, saddr = pcall(mono_class_getStaticFieldAddress, 0, info.class)
  if oks and saddr then log('  staticAddr: ' .. hf(saddr)) end
end

log('=== DE probe1 done ===')
out:close()
  </LuaScript>
</CheatTable>
