              <ID>127547</ID>
              <Description>"SeinCharacter"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>usemono()
//Character
getmonostruct(SeinCharacter)
define(SeinCharacterFixedUpdateBytes,8B 40 34 83 EC 0C)
registersymbol(SeinCharacterFixedUpdateBytes)
[ENABLE]
assert(SeinCharacterFixedUpdate,SeinCharacterFixedUpdateBytes)
alloc(newmem,$1000)

alloc(pSeinCharacter,4)
registersymbol(pSeinCharacter)

label(code)
label(return)

newmem:

code:
  mov [pSeinCharacter],eax
  mov eax,[eax+34]
  sub esp,0C
  jmp return

SeinCharacterFixedUpdate:
  jmp code
  nop
return:

[DISABLE]
//Character
SeinCharacterFixedUpdate:
 db SeinCharacterFixedUpdateBytes

unregistersymbol(pSeinCharacter)
unregistersymbol(SeinCharacterFixedUpdateBytes)

dealloc(pSeinCharacter)
dealloc(newmem)
</AssemblerScript>
