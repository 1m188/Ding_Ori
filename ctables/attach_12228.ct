<CheatTable CheatEngineTableVersion="27">
  <CheatEntries>
    <CheatEntry>
      <ID>127430</ID>
      <Description>"Enable me first"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>usemono()
//Character
define(SeinCharacterFixedUpdate,SeinCharacter:FixedUpdate+9)
//Multiple Double Jumps
define(SeinDoubleJumpPerformDoubleJump,SeinDoubleJump:PerformDoubleJump+6d)
//Multiple Single Jumps
define(SeinJumpUpdateCharacterState1,SeinJump:UpdateCharacterState+2d)
define(SeinJumpUpdateCharacterState2,SeinJump:UpdateCharacterState+49)
define(SeinJumpPerformJump,SeinJump:PerformJump+47a)
//Time
define(GameTimerget_TotalSeconds,GameTimer:get_TotalMinutes+6)
define(GameTimerget_TotalMinutes,GameTimer:get_TotalMinutes+17)
define(GameTimerget_TotalHours,GameTimer:get_Hours+2c)
//Death Counter
define(SeinDeathCounterset_Count,SeinDeathCounter:get_Count+28)
//Achievements Logic
define(AchievementsLogicFixedUpdate,AchievementsLogic:FixedUpdate+7)
define(SeinPickupProcessorOnCollectExpOrbPickup,SeinPickupProcessor:OnCollectExpOrbPickup+12)
//Free Energy
define(SeinEnergySpend,SeinEnergy:Spend+10)
//No Damage
define(SeinHealthControllerTakeDamage,SeinHealthController:TakeDamage+1d)
//Invincibility
define(SeinDamageRecieverOnRecieveDamage,SeinDamageReciever:OnRecieveDamage+71)
//Rapid Fire
define(ShotComboUpdateState1,ShotCombo:UpdateState+64)
define(ShotComboUpdateState2,ShotCombo:UpdateState+17)
define(ShotComboUpdateState3,ShotCombo:UpdateState+4a)
[ENABLE]
//Character
registersymbol(SeinCharacterFixedUpdate)
//Multiple Double Jumps
registersymbol(SeinDoubleJumpPerformDoubleJump)
//Multiple Single Jumps
registersymbol(SeinJumpUpdateCharacterState1)
registersymbol(SeinJumpUpdateCharacterState2)
registersymbol(SeinJumpPerformJump)
//Time
registersymbol(GameTimerget_TotalSeconds)
registersymbol(GameTimerget_TotalMinutes)
registersymbol(GameTimerget_TotalHours)
//Death Counter
registersymbol(SeinDeathCounterset_Count)
//Achievements Logic
registersymbol(AchievementsLogicFixedUpdate)
registersymbol(SeinPickupProcessorOnCollectExpOrbPickup)
//Free Energy
registersymbol(SeinEnergySpend)
//No Damage
registersymbol(SeinHealthControllerTakeDamage)
//Invincibility
registersymbol(SeinDamageRecieverOnRecieveDamage)
//Rapid Fire
registersymbol(ShotComboUpdateState1)
registersymbol(ShotComboUpdateState2)
registersymbol(ShotComboUpdateState3)
//Cheats
//Flags
alloc(_DJump,4)
alloc(_Jump,4)
alloc(_FreeEnergy,4)
alloc(_NoDamage,4)
alloc(_Invincibility,4)
alloc(_RapidFire,4)

registersymbol(_DJump)
registersymbol(_Jump)
registersymbol(_FreeEnergy)
registersymbol(_NoDamage)
registersymbol(_Invincibility)
registersymbol(_RapidFire)

[DISABLE]
unregistersymbol(_DJump)
unregistersymbol(_Jump)
unregistersymbol(_FreeEnergy)
unregistersymbol(_NoDamage)
unregistersymbol(_Invincibility)
unregistersymbol(_RapidFire)

dealloc(_DJump)
dealloc(_Jump)
dealloc(_FreeEnergy)
dealloc(_NoDamage)
dealloc(_Invincibility)
dealloc(_RapidFire)

//Character
unregistersymbol(SeinCharacterFixedUpdate)
//Multiple Double Jumps
unregistersymbol(SeinDoubleJumpPerformDoubleJump)
//Multiple Single Jumps
unregistersymbol(SeinJumpUpdateCharacterState1)
unregistersymbol(SeinJumpUpdateCharacterState2)
unregistersymbol(SeinJumpPerformJump)
//Time
unregistersymbol(GameTimerget_TotalSeconds)
unregistersymbol(GameTimerget_TotalMinutes)
unregistersymbol(GameTimerget_TotalHours)
//Death Counter
unregistersymbol(SeinDeathCounterset_Count)
//Achievements Logic
unregistersymbol(AchievementsLogicFixedUpdate)
unregistersymbol(SeinPickupProcessorOnCollectExpOrbPickup)
//Free Energy
unregistersymbol(SeinEnergySpend)
//No Damage
unregistersymbol(SeinHealthControllerTakeDamage)
//Invincibility
unregistersymbol(SeinDamageRecieverOnRecieveDamage)
//Rapid Fire
unregistersymbol(ShotComboUpdateState1)
unregistersymbol(ShotComboUpdateState2)
unregistersymbol(ShotComboUpdateState3)


</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>127903</ID>
          <Description>"Cheats"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Cheats
//Free Energy
getmonostruct(SeinEnergy)
define(SeinEnergySpendBytes,DE E9 D9 5F 20)
registersymbol(SeinEnergySpendBytes)
//No Damage
getmonostruct(SeinHealthController)
define(SeinHealthControllerTakeDamageBytes,DE E9 D9 5E 1C)
registersymbol(SeinHealthControllerTakeDamageBytes)
//Invincibility
getmonostruct(SeinDamageReciever)
define(SeinDamageRecieverOnRecieveDamageBytes,0F B6 46 4C 85 C0)
registersymbol(SeinDamageRecieverOnRecieveDamageBytes)
//Multiple Double Jumps
getmonostruct(SeinDoubleJump)
define(SeinDoubleJumpPerformDoubleJumpBytes,48 89 47 40 8B 47 30)
registersymbol(SeinDoubleJumpPerformDoubleJumpBytes)
//Multiple Single Jumps
getmonostruct(SeinJump)
define(SeinJumpUpdateCharacterState1Bytes,DE E9 D9 9F 88 00 00 00)
define(SeinJumpUpdateCharacterState2Bytes,D9 47 58 D9 9F 88 00 00 00)
define(SeinJumpPerformJumpBytes,D9 EE D9 9F 88 00 00 00)
registersymbol(SeinJumpUpdateCharacterState1Bytes)
registersymbol(SeinJumpUpdateCharacterState2Bytes)
registersymbol(SeinJumpPerformJumpBytes)
//Rapid Fire
getmonostruct(ShotCombo)
define(ShotComboUpdateState1Bytes,D9 47 0C DF F1)
define(ShotComboUpdateState2Bytes,D9 47 10 DF F1)
define(ShotComboUpdateState3Bytes,D9 47 14 DF F1)
registersymbol(ShotComboUpdateState1Bytes)
registersymbol(ShotComboUpdateState2Bytes)
registersymbol(ShotComboUpdateState3Bytes)
[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
assert(SeinEnergySpend,SeinEnergySpendBytes)
assert(SeinHealthControllerTakeDamage,SeinHealthControllerTakeDamageBytes)
assert(SeinDamageRecieverOnRecieveDamage,SeinDamageRecieverOnRecieveDamageBytes)
assert(SeinDoubleJumpPerformDoubleJump,SeinDoubleJumpPerformDoubleJumpBytes)
assert(SeinJumpPerformJump,SeinJumpPerformJumpBytes)
assert(SeinJumpUpdateCharacterState1,SeinJumpUpdateCharacterState1Bytes)
assert(SeinJumpUpdateCharacterState2,SeinJumpUpdateCharacterState2Bytes)
assert(ShotComboUpdateState1,ShotComboUpdateState1Bytes)
assert(ShotComboUpdateState2,ShotComboUpdateState2Bytes)
assert(ShotComboUpdateState3,ShotComboUpdateState3Bytes)

alloc(FreeEnergy,$1000)
alloc(NoDamage,$1000)
alloc(Invincibility,$1000)
alloc(MDJump,$1000)
alloc(MSJump1,$1000)
alloc(MSJump2,$1000)
alloc(MSJump3,$1000)
alloc(ShotCombo1,$1000)
alloc(ShotCombo2,$1000)
alloc(ShotCombo3,$1000)

//Free Energy
label(FEOC)
//No Damage
label(NDOC)
//Invincibility
label(InOC)
//Multiple Double Jumps
label(MDJOC)
//Multiple Single Jumps
label(MSJ1OC)
label(MSJ2OC)
label(MSJ3OC)
//Rapid Fire
label(SCOC1)
label(SCOC2)
label(SCOC3)
//Restore Original State
label(exit)
label(ESC1)
label(ESC2)
label(ESC3)
//Free Energy
label(FER)
//No Damage
label(NDR)
//Invincibility
label(InR)
//Multiple Double Jumps
label(MDJR)
//Multiple Single Jumps
label(MSJ1R)
label(MSJ2R)
label(MSJ3R)
//Rapid Fire
label(SCR1)
label(SCR2)
label(SCR3)

//Free Energy
FreeEnergy:
  cmp byte ptr [_FreeEnergy],0
  je FEOC
  fsubp st(1),st(0)
  fstp dword ptr [edi+20]
  fld dword ptr [edi+24]
  fstp dword ptr [edi+20]
  jmp FER
FEOC:
  fsubp st(1),st(0)
  fstp dword ptr [edi+20]
  jmp FER

SeinEnergySpend:
  jmp FreeEnergy
FER:

//No Damage
NoDamage:
  cmp byte ptr [_NoDamage],0
  je NDOC
  fsubp st(1),st(0)
  fstp dword ptr [esi+1C]
  push eax
  mov eax,[esi+28]
  mov [esi+1C],eax
  pop eax
  jmp NDR
NDOC:
  fsubp st(1),st(0)
  fstp dword ptr [esi+1C]
  jmp NDR

SeinHealthControllerTakeDamage:
  jmp NoDamage
NDR:

//Invincibility
Invincibility:
  cmp byte ptr [_Invincibility],1
  jne exit
  mov [esi+4C],1 //Activates invincibility
  movzx eax,byte ptr [esi+4C]
  test eax,eax
  jmp InR

InOC:
  movzx eax,byte ptr [esi+4C]
  test eax,eax
  jmp InR

exit:
  mov [esi+4C],0 //Removes invincibility
  movzx eax,byte ptr [esi+4C]
  test eax,eax
  jmp InR

SeinDamageRecieverOnRecieveDamage:
  jmp Invincibility
  nop
InR:

//Multiple Double Jumps
MDJump:
  cmp byte ptr [_DJump],0
  je MDJOC
  mov [edi+40],eax
  mov eax,[edi+30]
  jmp MDJR
MDJOC:
  dec eax
  mov [edi+40],eax
  mov eax,[edi+30]
  jmp MDJR

SeinDoubleJumpPerformDoubleJump:
  jmp MDJump
  nop
  nop
MDJR:

//Multiple Single Jumps

MSJump1:
  cmp byte ptr [_Jump],0
  je MSJ1OC
  fsubp st(1),st(0)
  fstp dword ptr [edi+00000088]
  push eax
  mov eax,[edi+58]
  mov [edi+00000088],eax
  pop eax
  jmp MSJ1R
MSJ1OC:
  fsubp st(1),st(0)
  fstp dword ptr [edi+00000088]
  jmp MSJ1R

SeinJumpUpdateCharacterState1:
  jmp MSJump1
  nop
  nop
  nop
MSJ1R:

MSJump2:
  cmp byte ptr [_Jump],0
  je MSJ2OC
  fld dword ptr [edi+58]
  fstp dword ptr [edi+00000088]
  jmp MSJ2R
MSJ2OC:
  fld dword ptr [edi+58]
  fstp dword ptr [edi+00000088]
  jmp MSJ2R

SeinJumpUpdateCharacterState2:
  jmp MSJump2
  nop
  nop
  nop
  nop
MSJ2R:

MSJump3:
  cmp byte ptr [_Jump],0
  je MSJ3OC
  fldz
  fstp dword ptr [edi+00000088]
  push eax
  mov eax,[edi+58]
  mov [edi+00000088],eax
  pop eax
  jmp MSJ3R
MSJ3OC:
  fldz
  fstp dword ptr [edi+00000088]
  jmp MSJ3R

SeinJumpPerformJump:
  jmp MSJump3
  nop
  nop
  nop
MSJ3R:

//Rapid Fire
////1
ShotCombo1:
  cmp byte ptr [_RapidFire],1
  jne ESC1
  mov [edi+0C],(float)0 //CooldownTimeForIncompleteCombo, is a constant of 0.3000000119
  fld dword ptr [edi+0C]
  fcomip st(0),st(1)
  jmp SCR1
SCOC1:
  fld dword ptr [edi+0C]
  fcomip st(0),st(1)
  jmp SCR1
ESC1:
  mov [edi+0C],(float)0.3000000119 //CooldownTimeForIncompleteCombo, restores original of 0.3000000119
  fld dword ptr [edi+0C]
  fcomip st(0),st(1)
  jmp SCR1

ShotComboUpdateState1:
  jmp ShotCombo1
SCR1:

////2
ShotCombo2:
  cmp byte ptr [_RapidFire],1
  jne ESC2
  mov [edi+10],(float)0 //CooldownTimeForCompletedCombo, is a constant of 0.5
  fld dword ptr [edi+10]
  fcomip st(0),st(1)
  jmp SCR2
SCOC2:
  fld dword ptr [edi+10]
  fcomip st(0),st(1)
  jmp SCR2
ESC2:
  mov [edi+10],(float)0.5 //CooldownTimeForCompletedCombo, restores original of 0.5
  fld dword ptr [edi+10]
  fcomip st(0),st(1)
  jmp SCR2

ShotComboUpdateState2:
  jmp ShotCombo2
SCR2:

////3
ShotCombo3:
  cmp byte ptr [_RapidFire],1
  jne ESC3
  mov [edi+14],(float)0 //ShotDelay, is a constant of 0.200000003
  fld dword ptr [edi+14]
  fcomip st(0),st(1)
  jmp SCR3
SCOC3:
  fld dword ptr [edi+14]
  fcomip st(0),st(1)
  jmp SCR3
ESC3:
  mov [edi+14],(float)0.200000003 //ShotDelay, restores original 0.200000003
  fld dword ptr [edi+14]
  fcomip st(0),st(1)
  jmp SCR3

ShotComboUpdateState3:
  jmp ShotCombo3
SCR3:

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
//Free Energy
SeinEnergySpend:
 db SeinEnergySpendBytes
unregistersymbol(SeinEnergySpendBytes)
dealloc(FreeEnergy)
//No Damage
SeinHealthControllerTakeDamage:
 db SeinHealthControllerTakeDamageBytes
unregistersymbol(SeinHealthControllerTakeDamageBytes)
dealloc(NoDamage)
//Invincibility
SeinDamageRecieverOnRecieveDamage:
  db SeinDamageRecieverOnRecieveDamageBytes
unregistersymbol(SeinDamageRecieverOnRecieveDamageBytes)
dealloc(Invincibility)
//Multiple Double Jumps
SeinDoubleJumpPerformDoubleJump:
 db SeinDoubleJumpPerformDoubleJumpBytes
unregistersymbol(SeinDoubleJumpPerformDoubleJumpBytes)
dealloc(MDJump)
//Multiple Single Jumps
SeinJumpUpdateCharacterState1:
 db SeinJumpUpdateCharacterState1Bytes
unregistersymbol(SeinJumpUpdateCharacterState1Bytes)
dealloc(MSJump1)

SeinJumpUpdateCharacterState2:
 db SeinJumpUpdateCharacterState2Bytes
unregistersymbol(SeinJumpUpdateCharacterState2Bytes)
dealloc(MSJump2)

SeinJumpPerformJump:
 db SeinJumpPerformJumpBytes
unregistersymbol(SeinJumpPerformJumpBytes)
dealloc(MSJump3)
//Rapid Fire
ShotComboUpdateState1:
 db ShotComboUpdateState1Bytes
unregistersymbol(ShotComboUpdateState1Bytes)
dealloc(ShotCombo1)

ShotComboUpdateState2:
 db ShotComboUpdateState2Bytes
unregistersymbol(ShotComboUpdateState2Bytes)
dealloc(ShotCombo2)

ShotComboUpdateState3:
 db ShotComboUpdateState3Bytes
unregistersymbol(ShotComboUpdateState3Bytes)
dealloc(ShotCombo3)
</AssemblerScript>
