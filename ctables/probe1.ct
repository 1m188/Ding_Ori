<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="41">
  <LuaScript>
local out = io.open('D:/code/Ding_Ori/ctables/mono_result.txt', 'w')
local function log(s) out:write(tostring(s) .. '\n') out:flush() end
local function hf(x) return string.format('0x%X', tonumber(x) or 0) end

log('=== probe1 start ===')
openProcess('ori.exe')
log('opened pid: ' .. tostring(getOpenedProcessID()))

local ok, err = pcall(function()
  log('mono functions: ' .. tostring(mono ~= nil))
  local dc = LaunchMonoDataCollector()
  log('datacollector: ' .. tostring(dc))
end)
if not ok then log('collector error: ' .. tostring(err)) end

local img = nil
local ok2, err2 = pcall(function()
  local asms = enumMonoAssemblies()
  log('assembly count: ' .. tostring(asms and #asms or 'nil'))
  for _, a in ipairs(asms or {}) do
    local im = mono_getImageFromAssembly(a)
    local nm = mono_image_get_name(im)
    if nm == 'Assembly-CSharp' then img = im end
  end
end)
if not ok2 then log('enum assemblies error: ' .. tostring(err2)) end
if not img then
  log('Assembly-CSharp NOT FOUND, aborting')
  log('=== probe1 done ===')
  out:close()
  return
end
log('Assembly-CSharp image: ' .. hf(img))

local NS = { '', 'Moon', 'Characters', 'Assets', 'Assets.Moon', 'Moon.Characters' }
local function findClass(n)
  for _, ns in ipairs(NS) do
    local okc, c = pcall(mono_image_findClass, img, n, ns)
    if okc and c and c ~= 0 then return c, ns end
  end
  return nil, nil
end

local names = { 'SaveGameController', 'SaveGameData', 'GameController', 'SeinCharacter', 'SeinEnergy', 'SeinHealth', 'SeinAbilities', 'SeinDeathCounter' }
for _, n in ipairs(names) do
  local cls, ns = findClass(n)
  if not cls then
    log('--- ' .. n .. ': NOT FOUND in tried namespaces')
  else
    log('--- ' .. n .. ' (ns=' .. tostring(ns) .. ') class=' .. hf(cls))
    local okf, fields = pcall(mono_class_enumFields, cls)
    if not okf then
      log('  enumFields error: ' .. tostring(fields))
    else
      for _, f in ipairs(fields or {}) do
        log('  field ' .. tostring(f.name) .. ' offset=' .. tostring(f.offset))
      end
    end
    local oks, saddr = pcall(mono_class_getStaticFieldAddress, cls)
    if oks then log('  staticAddr: ' .. hf(saddr)) else log('  staticAddr err: ' .. tostring(saddr)) end
  end
end

log('=== probe1 done ===')
out:close()
  </LuaScript>
</CheatTable>
