<Project Sdk="Microsoft.NET.Sdk">

  <!--
    终极版修改器主程序（控制台），运行在游戏进程之外。
    目标框架 net48，输出 exe。
  -->
  <PropertyGroup>
    <!--
      Edition：区分两版游戏（Vanilla=原版 / DE=终极版），与 Debug/Release 正交。
      默认 Vanilla（原版）；构建终极版时传 -p:Edition=DE。
      这是全局属性：命令行传了就保持，不传才在这里补默认值。
    -->
    <Edition Condition="'$(Edition)'==''">Vanilla</Edition>

    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>

    <!--
      exe 名按 Edition 区分，两版产物可共存、互不覆盖：
        原版   OriTrainer.exe
        终极版 OriTrainerDE.exe
    -->
    <AssemblyName Condition="'$(Edition)'=='DE'">OriTrainerDE</AssemblyName>
    <AssemblyName Condition="'$(Edition)'!='DE'">OriTrainer</AssemblyName>
    <RootNamespace>OriTrainer</RootNamespace>
  </PropertyGroup>

  <!--
    要求管理员权限。理由与实测边界见 app.manifest 内的注释。
    一句话：注入需要 PROCESS_ALL_ACCESS，requireAdministrator 把完整性级别关系一次锁死。
  -->
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 两端共享的源码（协议常量等），不是共享程序集 -->
  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    SharpMonoInjector 以「源码」方式编入本 exe，不用 ProjectReference：
      1. 它不在 NuGet 上（已确认搜索无结果），无法 PackageReference。
      2. 它是 netstandard2.0，作为独立程序集会让输出目录多一个 dll。
    vendor\ 下只保留注入所需文件，Eject 已移除
  -->
  <ItemGroup>
    <Compile Include="..\..\vendor\SharpMonoInjector\**\*.cs" LinkBase="Vendor" />
  </ItemGroup>

  <!--
    注入载荷（OriTrainerDLL，net35），构建顺序由这条引用保证。
    两个开关缺一不可：
      ReferenceOutputAssembly=false  —— 不把 DLL 当程序集引用（net35 的类型本 exe 用不到）
      OutputItemType=InjectedPayload  —— 把 DLL 的输出路径装进同名 item，供下面的 Target 取用
  -->
  <ItemGroup>
    <ProjectReference Include="..\OriTrainerDLL\OriTrainerDLL.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>InjectedPayload</OutputItemType>
    </ProjectReference>
  </ItemGroup>

  <!--
    把注入载荷嵌进 exe。

    为什么必须用 Target 而不是静态 ItemGroup：
      静态 <ItemGroup Condition="Exists('...')"> 在【求值阶段】展开，
      而 ProjectReference 要到【执行阶段】才产出 dll —— 干净构建时文件还不存在，
      条件恒为 false，且 MSBuild 不会报错，是个静默的空操作。

    为什么挂在 AssignTargetPaths：
      真实构建顺序是 ResolveReferences → PrepareResources → Compile，而
      PrepareResources → PrepareResourceNames → AssignTargetPaths 是资源链的入口。
      挂在更晚的 CreateManifestResourceNames / PrepareResources 都会赶不上
      （资源名与编译输入此时已经算完），挂在这里才能被正常处理。

    LogicalName 固定资源名，运行时用 GetManifestResourceStream("OriTrainerDLL.dll") 取，
    不依赖 RootNamespace 与文件路径，改名/挪目录都不会悄悄变。
  -->
  <Target Name="EmbedInjectionPayload"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveProjectReferences">

    <ItemGroup>
      <EmbeddedResource Include="@(InjectedPayload)">
        <LogicalName>OriTrainerDLL.dll</LogicalName>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>

    <!-- 载荷没拿到就是确定性错误，不能静默产出"少了一半"的 exe -->
    <Error Condition="'@(InjectedPayload)' == '' and '$(DesignTimeBuild)' != 'true'"
           Text="未能取得注入载荷路径：ProjectReference 到 OriTrainerDLL 没有产出。请检查 src\OriTrainerDLL\OriTrainerDLL.csproj 是否可编译。" />
  </Target>

</Project>
