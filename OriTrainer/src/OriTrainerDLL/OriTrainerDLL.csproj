<Project Sdk="Microsoft.NET.Sdk">

  <!--
    修改器注入用的 DLL，加载进游戏进程内。
    目标框架 net35（游戏内置 Mono 2.x，只认 .NET 3.5 程序集），输出 dll。
  -->
  <PropertyGroup>
    <!--
      Edition：区分两版游戏（Vanilla=原版 / DE=终极版），与 Debug/Release 正交。
      默认 Vanilla（原版）；构建终极版时传 -p:Edition=DE。
      与 exe 项目同一套 Edition：命令行传 -p:Edition=DE 时作为全局属性
    -->
    <Edition Condition="'$(Edition)'==''">Vanilla</Edition>

    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>

    <!--
      DLL 产物名按 Edition 区分：
        原版   OriTrainerDLL.dll
        终极版 OriTrainerDEDLL.dll
    -->
    <AssemblyName Condition="'$(Edition)'=='DE'">OriTrainerDEDLL</AssemblyName>
    <AssemblyName Condition="'$(Edition)'!='DE'">OriTrainerDLL</AssemblyName>
    <RootNamespace>OriTrainerDLL</RootNamespace>

    <!-- 条件编译开关：DE 版定义 DE，原版不定义。代码里用 #if DE 切两版差异。 -->
    <DefineConstants Condition="'$(Edition)'=='DE'">$(DefineConstants);DE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 两端共享的源码（协议常量等），不是共享程序集：net35 与 net48 无法共用同一份二进制 -->
  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    功能代码按 Edition 只编一份：SDK 默认自动包含所有 .cs，
    不加下面两条就会把 Features-DE 和 Features 两个目录都编进来，
    而它们各自依赖不同版本的游戏程序集，混编必然编译失败。
      DE      编 Features-DE\
      原版    编 Features\
  -->
  <ItemGroup>
    <Compile Remove="Features-DE\**\*.cs" Condition="'$(Edition)'!='DE'" />
    <Compile Remove="Features\**\*.cs" Condition="'$(Edition)'=='DE'" />
  </ItemGroup>

  <!--
    游戏程序集按 Edition 引用：
      原版    lib\    （Ori，Unity 5.0.0b5）
      终极版  lib-DE\ （Ori DE，Unity 5.3.2f1）
    两个目录里的程序集是不同版本的游戏，类型与成员签名有差异，绝不可混用，
    所以这里用两个互斥的 ItemGroup，任意一次构建只进其中一个。

    Private=false 是必须的：这些程序集在游戏进程里已经存在，运行时由游戏提供。
    若设为 true，编译会把它们复制到输出目录（约 3MB），既污染发布包，
    也可能让游戏加载到错误版本。
  -->
  <ItemGroup Condition="'$(Edition)'=='DE'">
    <Reference Include="UnityEngine">
      <HintPath>..\..\lib-DE\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib-DE\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\lib-DE\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Edition)'!='DE'">
    <Reference Include="UnityEngine">
      <HintPath>..\..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\lib\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
