<Project Sdk="Microsoft.NET.Sdk">

  <!--
    终极版修改器注入用的 DLL，加载进游戏进程内。
    目标框架 net35（游戏内置 Mono 2.x，只认 .NET 3.5 程序集），输出 dll。
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OriTrainerDLL</AssemblyName>
    <RootNamespace>OriTrainerDLL</RootNamespace>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 两端共享的源码（协议常量等），不是共享程序集：net35 与 net48 无法共用同一份二进制 -->
  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    游戏程序集，从 lib\ 直接引用（游戏已停更，版本固定）。

    Private=false 是必须的：这些程序集在游戏进程里已经存在，运行时由游戏提供。
    若设为 true，编译会把它们复制到输出目录（约 3MB），既污染发布包，
    也可能让游戏加载到错误版本。
  -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\lib\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
