<Project Sdk="Microsoft.NET.Sdk">

  <!--
    终极版修改器主程序（控制台），运行在游戏进程之外。
    目标框架 net48，输出 exe。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>OriTrainerDE</AssemblyName>
    <RootNamespace>OriTrainerDE</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
